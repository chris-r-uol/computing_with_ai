{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Self-check expected answers",
  "description": "Two implementations read this file: src/cwai/checks.py and the site's JavaScript. checks/README.md states the comparison contract they must agree on. Note that tolerance is permitted only on a number entry, because that is the only entry the comparator applies it to.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["type", "value"],
    "additionalProperties": false,
    "properties": {
      "type": {"enum": ["number", "string", "list", "shape"]},
      "value": {},
      "tolerance": {"type": "number", "minimum": 0}
    },
    "allOf": [
      {
        "if": {
          "required": ["type"],
          "properties": {"type": {"const": "number"}}
        },
        "then": {"properties": {"value": {"type": "number"}}},
        "else": {"properties": {"tolerance": false}}
      },
      {
        "if": {"properties": {"type": {"const": "string"}}},
        "then": {"properties": {"value": {"type": "string"}}}
      },
      {
        "if": {"properties": {"type": {"const": "list"}}},
        "then": {"properties": {"value": {"type": "array"}}}
      },
      {
        "if": {"properties": {"type": {"const": "shape"}}},
        "then": {
          "properties": {
            "value": {
              "type": "array",
              "items": {"type": "integer"},
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    ]
  }
}
